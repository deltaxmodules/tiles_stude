# Preferred: set the full Ollama URL explicitly.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional fallback pieces (used only if OLLAMA_BASE_URL is not set).
# OLLAMA_HOST=127.0.0.1
# OLLAMA_PORT=11434

# HTTP client timeouts (seconds)
HTTP_TIMEOUT_SECONDS=120
PREWARM_HTTP_TIMEOUT_SECONDS=30

# Routing / cache defaults
DEFAULT_TILE_NAME=general
DEFAULT_TILE_TTL_SECONDS=3600
DEFAULT_CACHE_SIMILARITY_THRESHOLD=0.85

# Embeddings
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# Scheduler
HISTORY_SIZE=10

# FastAPI / Uvicorn bind
APP_HOST=0.0.0.0
APP_PORT=8000
